{
  "manifest_version": 3,
  "name": "Claude Usage Widget",
  "version": "1.0",
  "description": "Pushes your claude.ai usage to the local desktop widget every 5 minutes.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude Usage Widget",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
